## Kopiera till .env och fyll i

# Postgres-anslutningssträng (gratis via https://neon.tech)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Slumpmässig sträng minst 32 tecken (generera t.ex. med: openssl rand -hex 32)
SESSION_SECRET=ange_en_lang_slumpmassig_strang_har

# Åtkomstkod för att logga in i appen
ACCESS_CODE=19701970hasan

# Sätts till "production" i produktion (Render gör detta automatiskt)
NODE_ENV=development

# Vilken port Express ska lyssna på (sätts av hostingplattformen i produktion)
PORT=8080
